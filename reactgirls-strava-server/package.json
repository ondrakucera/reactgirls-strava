{
	"name": "reactgirls-strava-server",
	"version": "0.0.0",
	"description": "Express server for ReactGirls Strava application",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"lint": "eslint src --ext .ts",
		"format": "prettier --write src/**/*.ts",
		"sync": "node dist/scripts/sync.js",
		"db:migrate": "node dist/database/migrate.js",
		"db:setup": "./scripts/dev-setup.sh",
		"db:reset": "./scripts/dev-reset.sh",
		"db:start": "docker-compose up -d",
		"db:stop": "docker-compose down",
		"db:logs": "docker-compose logs -f postgres",
		"db:utils": "tsx src/utils/dbUtils.ts",
		"sync:dev": "tsx src/scripts/sync.ts"
	},
	"dependencies": {
		"express": "^4.18.2",
		"cors": "^2.8.5",
		"helmet": "^7.1.0",
		"dotenv": "^16.3.1",
		"pg": "^8.11.3",
		"axios": "^1.6.2",
		"date-fns": "^3.0.6"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/cors": "^2.8.17",
		"@types/node": "^20.10.0",
		"@types/pg": "^8.10.9",
		"typescript": "^5.3.2",
		"tsx": "^4.6.0",
		"eslint": "^8.55.0",
		"@typescript-eslint/eslint-plugin": "^6.13.1",
		"@typescript-eslint/parser": "^6.13.1",
		"prettier": "^3.1.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
